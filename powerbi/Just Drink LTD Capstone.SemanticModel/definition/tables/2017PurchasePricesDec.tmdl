table 2017PurchasePricesDec
	lineageTag: 59dc8770-0214-41fe-be9e-fe12c44e04ed

	/// Total sales amount in dollars (sum of SalesDollars)
	measure 'Total Sales ($)' = SUM ( SalesFINAL12312016[SalesDollars] )
		formatString: "$"#,0.00;-"$"#,0.00
		displayFolder: 01 Sales
		lineageTag: 42e9dca8-d42a-42e5-9b57-f4a037dd511b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Total units sold
	measure 'Total Quantity Sold' = SUM(SalesFINAL12312016[SalesQuantity])
		formatString: #,0
		displayFolder: 01 Sales
		lineageTag: 97576f14-c165-4af7-a992-7da72cab3728

	/// Percentage of total sales by Category
	measure '% Sales by Category' =
			
			DIVIDE(
			    SUM(SalesFINAL12312016[SalesDollars]),
			    CALCULATE(SUM(SalesFINAL12312016[SalesDollars]), ALL(SalesFINAL12312016))
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 01 Sales
		lineageTag: 060832b3-849e-4ae2-8f74-4625a872afdb

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Average selling price per unit
	measure 'Avg Selling Price' = ```
			
			DIVIDE(
			    SUM(SalesFINAL12312016[SalesDollars]),
			    SUM(SalesFINAL12312016[SalesQuantity])
			)
			
			```
		formatString: "$"#,0.00;-"$"#,0.00
		displayFolder: 01 Sales
		lineageTag: f6475375-1ac4-49b2-a987-0ff8bcd7f742

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Total purchase amount in dollars
	measure 'Total Purchase ($)' = SUM(PurchasesFINAL12312016[Dollars])
		formatString: "$"#,0.00;-"$"#,0.00
		displayFolder: 02 Purchases
		lineageTag: a7c4539d-76f4-45cc-a304-f482fcc3ba9b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Total quantity purchased
	measure 'Total Purchased Qty' = SUM(PurchasesFINAL12312016[Quantity])
		formatString: #,0
		displayFolder: 02 Purchases
		lineageTag: 7c7b46ab-ea95-4311-8e8f-0960becc6bc3

	/// Distinct count of purchase orders
	measure 'PO Count' = DISTINCTCOUNT(PurchasesFINAL12312016[PONumber])
		formatString: #,0
		displayFolder: 02 Purchases
		lineageTag: d14792b9-dd83-47d6-bac5-056751eec80e

	/// Monthly purchase amount in dollars
	measure 'Monthly Purchase ($)' =
			
			CALCULATE(
			    SUM(PurchasesFINAL12312016[Dollars]),
			    GROUPBY(
			        PurchasesFINAL12312016,
			        PurchasesFINAL12312016[PODate]
			    )
			)
		formatString: "$"#,0.00;-"$"#,0.00
		displayFolder: 02 Purchases
		lineageTag: cd080811-e0e1-4055-aad3-6e0d66b12b03

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Vendor ranking score (lower = more critical)
	measure 'Critical Supplier Score' =
			
			RANKX(
			    ALL(PurchasesFINAL12312016[VendorName]),
			    SUM(PurchasesFINAL12312016[Dollars]) + COUNTROWS(PurchasesFINAL12312016),
			    ,
			    DESC
			)
		formatString: #,0
		displayFolder: 02 Purchases
		lineageTag: 9044055a-c167-4eb8-a34d-3294a08a9a3c

	/// Average purchase amount per purchase order
	measure 'Avg Purchase per PO' = DIVIDE ( [Total Purchase ($)], [PO Count] )
		formatString: "$"#,0.00;-"$"#,0.00
		displayFolder: 02 Purchases
		lineageTag: ba8251ea-da8b-4972-8a72-f95f40083328

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Average units on hand: total beginning plus total ending inventory, divided by 2.
	measure AvgInv = ( SUM ( BegInvFINAL12312016[onHand] ) + SUM ( EndInvFINAL12312016[onHand] ) ) / 2
		formatString: #,0
		displayFolder: 03 Inventory
		lineageTag: 2f603c62-2340-4f1f-ac0e-b24c538542dd

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Units sold divided by average units on hand. How many times stock sold through in the period.
	measure 'Inventory Turnover' = DIVIDE([Total Quantity Sold], [AvgInv])
		formatString: 0.00
		displayFolder: 03 Inventory
		lineageTag: bf083250-1d42-4e68-81ed-5e6bf33f7226

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Net change in stock (Purchased Qty - Sold Qty)
	measure 'Net Stock Change' = [Total Purchased Qty] - [Total Quantity Sold]
		formatString: #,0;-#,0
		displayFolder: 03 Inventory
		lineageTag: f37a1c8e-0c4d-47cc-a970-c0775b16f364

	/// Beginning inventory value (qty * price)
	measure 'BegInv Value' =
			SUMX(
			    BegInvFINAL12312016,
			    BegInvFINAL12312016[onHand] * BegInvFINAL12312016[Price]
			)
		formatString: "$"#,0.00;-"$"#,0.00
		displayFolder: 03 Inventory
		lineageTag: af297356-2140-407b-9600-5750df70b79b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Ending inventory value (qty * price)
	measure 'EndInv Value' =
			SUMX(
			    EndInvFINAL12312016,
			    EndInvFINAL12312016[onHand] * EndInvFINAL12312016[Price]
			)
		formatString: "$"#,0.00;-"$"#,0.00
		displayFolder: 03 Inventory
		lineageTag: e3380ecd-4465-4029-86fe-a7c811afdbc6

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Average inventory value in dollars
	measure 'AvgInv Value' = ([BegInv Value] + [EndInv Value]) / 2
		formatString: "$"#,0.00;-"$"#,0.00
		displayFolder: 03 Inventory
		lineageTag: 449a6e6a-d495-4e4b-812e-409a71698440

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Inventory turnover ratio ($-based): Total Sales / Average Inventory Value
	measure 'Inventory Turnover Value' = DIVIDE([Total Sales ($)], [AvgInv Value])
		formatString: 0.00
		displayFolder: 03 Inventory
		lineageTag: 5d802175-ff92-4af2-8573-5b28256c3f62

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Sales of products classified as Wine (Classification = 1)
	measure 'Wine Sales' = CALCULATE ( [Total Sales ($)], SalesFINAL12312016[Classification] = 1 )
		formatString: "$"#,0.00;-"$"#,0.00
		displayFolder: 01 Sales
		lineageTag: b475aadf-65ed-4205-ab0b-c3957c21c06e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Sales of products classified as Spirits (Classification = 2)
	measure 'Spirit Sales' = CALCULATE ( [Total Sales ($)], SalesFINAL12312016[Classification] = 2 )
		formatString: "$"#,0.00;-"$"#,0.00
		displayFolder: 01 Sales
		lineageTag: 61faedd0-52b3-4946-8783-fab51e5b863b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Percentage of total sales by Classification
	measure '% of Total Sales' = DIVIDE ( [Total Sales ($)], CALCULATE ( [Total Sales ($)], ALL ( SalesFINAL12312016[Classification] ) ) )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 01 Sales
		lineageTag: a5662584-fb76-4af8-8c30-369ee3b871be

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Total quantity of items sold grouped by Size
	measure 'Total Quantity by Size' =
			
			SUMX (
			    VALUES ( SalesFINAL12312016[Size] ),
			    CALCULATE ( SUM ( SalesFINAL12312016[SalesQuantity] ) )
			)
		formatString: #,0
		displayFolder: 01 Sales
		lineageTag: 797d4c99-563f-4180-81c6-9fce9ec32629

	/// Total Cost of Goods Sold (sum of FactPurchases.Dollars)
	measure 'Total COGS' = SUM ( PurchasesFINAL12312016[Dollars] )
		formatString: "$"#,0.00;-"$"#,0.00
		displayFolder: 04 Profitability
		lineageTag: f0457292-2ee0-4bcf-a893-6c56e2570d9a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Gross profit (Total Sales - Total COGS)
	measure 'Gross Profit' = [Total Sales ($)] - [Total COGS]
		formatString: "$"#,0.00;-"$"#,0.00
		displayFolder: 04 Profitability
		lineageTag: d1d7629e-7722-47e9-8a38-9979aad020c3

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Gross profit margin: Gross Profit / Total Sales
	measure 'Gross Profit Margin (%)' = DIVIDE ( [Gross Profit], [Total Sales ($)], 0 )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 04 Profitability
		lineageTag: 85c8f9b9-a92a-48c7-ba63-3775bbda4449

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Month-over-month sales growth percentage
	measure 'Sales Growth %' =
			VAR CurrentRevenue = [Total Sales ($)]
			VAR PrevRevenue = CALCULATE ( [Total Sales ($)], PREVIOUSMONTH ( 'Date'[Date] ) )
			RETURN IF ( ISBLANK ( PrevRevenue ) || PrevRevenue = 0, BLANK(), DIVIDE ( CurrentRevenue - PrevRevenue, PrevRevenue ) )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 05 Time Intelligence
		lineageTag: f48154ce-00dd-404c-b191-b25d8f4d3b25

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Average days to sell through stock: 365 divided by Inventory Turnover.
	measure 'Shelf Time (Day)' = DIVIDE ( 365, [Inventory Turnover] )
		formatString: 0.0
		displayFolder: 03 Inventory
		lineageTag: ce019877-11bc-47b3-a842-104cf493dc74

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Alias of [Total Sales ($)] - kept for backward compatibility with existing visuals
	measure 'Total Revenue' = [Total Sales ($)]
		formatString: "$"#,0.00;-"$"#,0.00
		isHidden
		displayFolder: 99 Aliases (Deprecated)
		lineageTag: ef89a4bd-07c3-4d47-a28a-cffdfd930356

