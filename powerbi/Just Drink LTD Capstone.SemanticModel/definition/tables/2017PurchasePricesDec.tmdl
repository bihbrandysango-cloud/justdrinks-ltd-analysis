		lineageTag: c7e9bdd4-11a1-4519-b303-b0927d9bd0e5

	/// Alias of [Total Purchase ($)] - kept for backward compatibility with existing visuals
	measure 'Total Purchase Value' = [Total Purchase ($)]
		formatString: "$"#,0.00;-"$"#,0.00
		isHidden
		displayFolder: 99 Aliases (Deprecated)
		lineageTag: 8bf894e8-1b1e-44d7-a192-e00266c872a9

	/// Alias of [Total Purchase ($)] - kept for backward compatibility with existing visuals
	measure 'Purchased Value' = [Total Purchase ($)]
		formatString: "$"#,0.00;-"$"#,0.00
		isHidden
		displayFolder: 99 Aliases (Deprecated)
		lineageTag: 7ef5ffd3-8159-45ec-94f5-9ea23aec9aa2

	/// Alias of [Total Purchased Qty] - kept for backward compatibility with existing visuals
	measure 'Total Purchase Quantity' = [Total Purchased Qty]
		formatString: #,0
		isHidden
		displayFolder: 99 Aliases (Deprecated)
		lineageTag: 33debde9-a92e-432e-b8c4-c3a8c3f0656d

	/// Alias of [Total Purchased Qty] - kept for backward compatibility with existing visuals
	measure 'Purchase Quantity' = [Total Purchased Qty]
		formatString: #,0
		isHidden
		displayFolder: 99 Aliases (Deprecated)
		lineageTag: 075143d2-ceb4-4d32-bc15-3fe06611d578

	/// Alias of [PO Count] - kept for backward compatibility with existing visuals
	measure 'Number of POs' = [PO Count]
		formatString: #,0
		isHidden
		displayFolder: 99 Aliases (Deprecated)
		lineageTag: e92eb497-bb50-42d9-8ca2-22085070e281

	/// Alias of [Inventory Turnover] - kept for backward compatibility with existing visuals
	measure 'Inventory Turnover Ratio' = [Inventory Turnover]
		formatString: 0.00
		isHidden
		displayFolder: 99 Aliases (Deprecated)
		lineageTag: c2223fbc-821a-4c20-9c08-80f5534589a4

	/// Alias of [Avg Selling Price] - kept for backward compatibility with existing visuals
	measure 'Average Selling Price' = [Avg Selling Price]
		formatString: "$"#,0.00;-"$"#,0.00
		isHidden
		displayFolder: 99 Aliases (Deprecated)
		lineageTag: e1741d7a-4d12-4a68-a5eb-02dc283b27f4

	/// Alias of [EndInv Value] - kept for backward compatibility with existing visuals
	measure 'Ending Inv ($)' = [EndInv Value]
		formatString: "$"#,0.00;-"$"#,0.00
		isHidden
		displayFolder: 99 Aliases (Deprecated)
		lineageTag: 6ad156bd-7a55-404e-a897-2ea133db70b9

	/// Year-to-date sales running total
	measure 'Sales YTD' = CALCULATE ( [Total Sales ($)], DATESYTD ( 'Date'[Date] ) )
		formatString: "$"#,0;-"$"#,0
		displayFolder: 05 Time Intelligence
		lineageTag: 8c79d1d5-e98b-4ab4-be64-311305337cf7

	/// Sales for the same period in the prior year
	measure 'Sales PY' = CALCULATE ( [Total Sales ($)], SAMEPERIODLASTYEAR ( 'Date'[Date] ) )
		formatString: "$"#,0;-"$"#,0
		displayFolder: 05 Time Intelligence
		lineageTag: cd0db6f6-4590-4642-9cb6-dc49f1175739

	/// Year-over-year sales delta in dollars
	measure 'Sales YoY $' = [Total Sales ($)] - [Sales PY]
		formatString: "$"#,0;-"$"#,0
		displayFolder: 05 Time Intelligence
		lineageTag: 40ff4e41-4285-4b37-8745-d1cabe6f2954

	/// Year-over-year sales delta as a percentage
	measure 'Sales YoY %' = DIVIDE ( [Sales YoY $], [Sales PY] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 05 Time Intelligence
		lineageTag: 77df325b-5e8c-4917-98ce-34c55acb8cc6

	/// Distinct count of stores active in the current filter context
	measure 'Active Stores' = DISTINCTCOUNT ( DimStore[Store] )
		formatString: #,0
		displayFolder: 06 Store Analysis
		lineageTag: 1dc09281-30ee-42d5-855b-70892cb5ded2

	/// Distinct count of brands sold in the current filter context
	measure 'Brands Sold' = CALCULATE ( DISTINCTCOUNT ( SalesFINAL12312016[Brand] ), SalesFINAL12312016[SalesQuantity] > 0 )
		formatString: #,0
		displayFolder: 01 Sales
		lineageTag: 7a987683-afef-4355-92f9-736bd0dd68e7

	/// Average sales per active store
	measure 'Sales per Store' = DIVIDE ( [Total Sales ($)], [Active Stores] )
		formatString: "$"#,0;-"$"#,0
		displayFolder: 06 Store Analysis
		lineageTag: d3cab302-6767-478b-9ef0-34b518485839

	/// KPI status for Gross Profit Margin: 1 = healthy (>30%), 0 = watch (>25%), -1 = below target (<=25%)
	measure 'GP Margin Status' = VAR M = [Gross Profit Margin (%)] RETURN SWITCH ( TRUE(), M > 0.30, 1, M > 0.25, 0, -1 )
		formatString: 0
		displayFolder: 04 Profitability
		lineageTag: dec6f928-b40c-427e-b5a7-11210e48a5a5

	/// KPI status for Inventory Turnover: 1 = healthy (>2), 0 = watch (>1), -1 = slow (<=1)
	measure 'Turnover Status' = VAR T = [Inventory Turnover] RETURN SWITCH ( TRUE(), T > 2, 1, T > 1, 0, -1 )
		formatString: 0
		displayFolder: 03 Inventory
		lineageTag: 8e0da0c9-6e8c-4724-a9be-d73e357eaf4f

	/// Dynamic page title that adapts to current filter context
	measure 'Dynamic Title' =
			VAR YearFilter =
			    IF (
			        ISFILTERED ( 'Date'[Year] ),
			        " · " & CONCATENATEX ( VALUES ( 'Date'[Year] ), 'Date'[Year], ", " ),
			        ""
			    )
			VAR CategoryFilter =
			    IF (
			        ISFILTERED ( SalesFINAL12312016[Category] ),
			        " · " & CONCATENATEX ( VALUES ( SalesFINAL12312016[Category] ), SalesFINAL12312016[Category], ", " ),
			        ""
			    )
			RETURN "JustDrinks LTD Performance" & YearFilter & CategoryFilter
		displayFolder: 07 Dashboard Helpers
		lineageTag: c49a3025-97ef-4db8-b412-169741294f47

