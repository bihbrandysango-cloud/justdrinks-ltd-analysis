              {
                "textRuns": [
                  {
                    "value": "Summary",
                    "textStyle": {
                      "fontSize": "12pt",
                      "fontWeight": "bold",
                      "color": "#6B7FB3"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "From tracking sales to driving profit",
                    "textStyle": {
                      "fontSize": "26pt",
                      "fontWeight": "bold",
                      "color": "#161A21"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "JustDrinks Ltd. has a strong revenue base: $452.1M in sales and a 28.8% gross margin across 80 stores, with spirits making 64% of sales.",
                    "textStyle": {
                      "fontSize": "16pt",
                      "color": "#161A21"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "The clearest gains are in timing, mix and store results. Buying holiday stock earlier closes the gap between December sales and purchases, protecting the two main sizes defends 85% of sales, and vendor volume gives room to negotiate.",
                    "textStyle": {
                      "fontSize": "16pt",
                      "color": "#161A21"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "The focus should shift from total sales to profit by product (SKU) and to store-level performance, with monthly stock counts so turnover can be tracked through the year.",
                    "textStyle": {
                      "fontSize": "16pt",
                      "color": "#161A21"
                    }
                  }
                ]
              }
            ]
          }
        }
