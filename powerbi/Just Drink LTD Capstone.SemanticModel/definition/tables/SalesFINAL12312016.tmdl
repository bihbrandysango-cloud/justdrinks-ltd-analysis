table SalesFINAL12312016
	lineageTag: 41213ace-9002-4964-a899-70f6fc33a98a

	/// Highest average selling price across stores
	measure 'Highest Avg Price' = MAXX ( VALUES ( SalesFINAL12312016[Store] ), [Avg Selling Price] )
		formatString: "$"#,0.00;-"$"#,0.00
		displayFolder: 06 Store Analysis
		lineageTag: 55d2b936-0044-45ea-bcaf-7bdd632f5117

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Lowest average selling price across stores
	measure 'Lowest Avg Price' = MINX ( VALUES ( SalesFINAL12312016[Store] ), [Avg Selling Price] )
		formatString: "$"#,0.00;-"$"#,0.00
		displayFolder: 06 Store Analysis
		lineageTag: e878a057-0d1d-4084-8ee4-1c7aa0a6165a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Store ID with the highest average selling price
	measure 'Store with Highest Price' =
			
			CALCULATE(
			    FIRSTNONBLANK ( SalesFINAL12312016[Store], 1 ),
			    FILTER (
			        VALUES ( SalesFINAL12312016[Store] ),
			        [Avg Selling Price] = [Highest Avg Price]
			    )
			)
		formatString: 0
		displayFolder: 06 Store Analysis
		lineageTag: 84bf3f17-5605-4d44-b8bf-548b6a902466

	/// Store ID with the lowest average selling price
	measure 'Store with Lowest Price' =
			
			CALCULATE(
			    FIRSTNONBLANK ( SalesFINAL12312016[Store], 1 ),
			    FILTER (
			        VALUES ( SalesFINAL12312016[Store] ),
			        [Avg Selling Price] = [Lowest Avg Price]
			    )
			)
		formatString: 0
		displayFolder: 06 Store Analysis
		lineageTag: 174c9902-f005-4e5a-b762-818519f3e11e

	/// Profit per row using SalesPrice - PurchasePrice * SalesQuantity
	measure Profit =
			
			SUMX(
			    'SalesFINAL12312016',
			    'SalesFINAL12312016'[SalesQuantity] *
			    (
			        'SalesFINAL12312016'[SalesPrice] -
			        RELATED('2017PurchasePricesDec'[PurchasePrice])
			    )
			)
		formatString: "$"#,0.00;-"$"#,0.00
		displayFolder: 04 Profitability
		lineageTag: b6dbe05c-8751-4a21-878e-35320dc52fc7

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Average days between an inventory item being received and its first sale (per InventoryId). Negative values (sold before received per data) treated as 0.
	measure 'Avg Shelf Time (Days)' =
			VAR FilteredHelper =
			    CALCULATETABLE (
			        '_ShelfTimeHelper',
			        TREATAS ( VALUES ( SalesFINAL12312016[Brand] ), '_ShelfTimeHelper'[Brand] )
			    )
			RETURN
			    AVERAGEX (
			        FilteredHelper,
			        IF ( '_ShelfTimeHelper'[ShelfDays] < 0, 0, '_ShelfTimeHelper'[ShelfDays] )
			    )
		formatString: 0.0
		displayFolder: 03 Inventory
		lineageTag: c36c3e78-6d49-4bf7-b738-944440943a16

		annotation PBI_FormatHint = {"isGeneralNumber":true}

